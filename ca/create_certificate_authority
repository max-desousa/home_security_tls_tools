#!/usr/bin/env bash
set -euo pipefail

# Configuration — edit these as needed
CA_NAME="My Camera System CA"
CA_DAYS=3650          # ~10 years
KEY_BITS=4096         # RSA key size

# Resolve the directory the script lives in
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prevent accidental overwrite
if [[ -f "$SCRIPT_DIR/ca.key" || -f "$SCRIPT_DIR/ca.crt" ]]; then
  echo "Error: CA files already exist in $SCRIPT_DIR/" >&2
  echo "  Refusing to overwrite:" >&2
  [[ -f "$SCRIPT_DIR/ca.key" ]] && echo "    - ca.key" >&2
  [[ -f "$SCRIPT_DIR/ca.crt" ]] && echo "    - ca.crt" >&2
  echo >&2
  echo "Remove or rename the existing files if you really want to generate a new CA." >&2
  exit 1
fi

echo "Generating CA private key..."
openssl genrsa -out "$SCRIPT_DIR/ca.key" "$KEY_BITS"
chmod 600 "$SCRIPT_DIR/ca.key"

echo "Generating self-signed CA certificate..."
openssl req -new -x509 \
  -key "$SCRIPT_DIR/ca.key" \
  -out "$SCRIPT_DIR/ca.crt" \
  -days "$CA_DAYS" \
  -subj "/CN=$CA_NAME" \
  -addext "basicConstraints=critical,CA:TRUE" \
  -addext "keyUsage=critical,keyCertSign,cRLSign"

echo
echo "Done."
echo "  Private key : $SCRIPT_DIR/ca.key   (keep this secret)"
echo "  Certificate : $SCRIPT_DIR/ca.crt   (distribute this to all nodes)"
